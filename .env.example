# ScraperAPI Key (fallback)
SCRAPER_API_KEY=your_scraperapi_key_here

# anyIP Residential Proxy URL (primary)
ANYIP_PROXY_URL=http://username:password@portal.anyip.io:1080

# Upstash Redis / Vercel KV (distributed 1-hour SWR caching)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
BEATROUTE_KV_REST_API_URL=https://your-database.upstash.io
BEATROUTE_KV_REST_API_TOKEN=your_upstash_token_here
